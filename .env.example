# --- Serpsling (server-side only, never exposed to buyers) ---
SERPSLING_AUTH_KEY=
SERPSLING_BASE_URL=https://api.serpsling.com

# --- Wrapper admin ---
ADMIN_TOKEN=change-me-to-a-long-random-string
KEY_PEPPER=change-me-to-a-long-random-string
DB_PATH=/app/data/mcp.db

# --- Safety rails ---
SITE_AUDIT_DEFAULT_PAGES=20
SITE_AUDIT_MAX_PAGES=100
CREATE_WAIT_TIMEOUT_S=180
CREATE_WAIT_INTERVAL_S=10
